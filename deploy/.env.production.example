# ───────────────────────────────────────────────────────────────────────────
# NeoOutcome AI — production environment
# Copy to deploy/.env.production and fill in. NEVER commit the filled file.
# Each block maps to the data sheet you were given (Сервер / Сайт команды / S3).
# ───────────────────────────────────────────────────────────────────────────

# ── Сервер (VPS) · used by deploy/deploy.sh only, never sent to containers ──
DEPLOY_HOST=            # Адрес     e.g. 185.xx.xx.xx or vps.example.kz
DEPLOY_USER=            # Логин     e.g. root or ubuntu
DEPLOY_PORT=22          # SSH port (Подключение). Password goes in your SSH agent / ssh-copy-id, not here.
DEPLOY_PATH=/opt/neooutcome-ai

# ── Сайт команды ──
DOMAIN=                 # Адрес     e.g. neooutcome.team-site.kz  (DNS A record → DEPLOY_HOST)
APP_PORT=443            # Порт приложения. 443 = Caddy terminates TLS automatically. Use e.g. 8080 for plain HTTP behind another proxy.
ACME_EMAIL=             # e-mail for Let's Encrypt notices

# ── Backend ──
NEO_JWT_SECRET=         # generate: openssl rand -hex 32
NEO_ENVIRONMENT=production
NEO_SEED_DEMO_DATA=true # set false once real (de-identified) data is loaded
POSTGRES_PASSWORD=      # generate: openssl rand -hex 16

# ── S3-хранилище · model registry + (later) imaging uploads ──
NEO_S3_ENDPOINT=        # Endpoint   e.g. https://s3.example.kz  (leave empty for AWS)
NEO_S3_BUCKET=          # Бакет
NEO_S3_ACCESS_KEY=      # Access Key
NEO_S3_SECRET_KEY=      # Secret Key
NEO_S3_REGION=          # Регион    e.g. ru-central1 / eu-central-1 / us-east-1
NEO_S3_PATH_STYLE=true  # Адресация: true = path-style (most S3-compatible stores), false = virtual-hosted (AWS)
